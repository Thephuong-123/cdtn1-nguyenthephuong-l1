        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 12\nhide methods\nhide stereotypes\n\ntitle ERD - L1 Quản lý và hợp nhất hồ sơ khách hàng\n\nentity \&quot;app_user\&quot; as app_user {\n  * user_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  full_name : VARCHAR(100) NOT NULL\n  role : VARCHAR(30) NOT NULL\n}\n\nentity \&quot;customer\&quot; as customer {\n  * customer_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  full_name : VARCHAR(120) NOT NULL\n  phone : VARCHAR(10) NOT NULL &lt;&lt;UNIQUE&gt;&gt;\n  email : VARCHAR(150)\n  address : VARCHAR(255)\n  created_at : TIMESTAMPTZ NOT NULL\n  updated_at : TIMESTAMPTZ NOT NULL\n  created_by : BIGINT &lt;&lt;FK&gt;&gt;\n  is_active : BOOLEAN NOT NULL\n}\n\nentity \&quot;duplicate_candidate\&quot; as duplicate_candidate {\n  * candidate_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  customer_id_1 : BIGINT NOT NULL &lt;&lt;FK&gt;&gt;\n  customer_id_2 : BIGINT NOT NULL &lt;&lt;FK&gt;&gt;\n  status : VARCHAR(20) NOT NULL\n  detected_at : TIMESTAMPTZ NOT NULL\n  reviewed_by : BIGINT &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;customer_merge\&quot; as customer_merge {\n  * merge_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  primary_customer_id : BIGINT NOT NULL &lt;&lt;FK&gt;&gt;\n  duplicate_customer_id : BIGINT NOT NULL &lt;&lt;FK&gt;&gt;\n  merged_by : BIGINT NOT NULL &lt;&lt;FK&gt;&gt;\n  merged_at : TIMESTAMPTZ NOT NULL\n}\n\napp_user ||--o{ customer : \&quot;tạo\&quot;\napp_user ||--o{ duplicate_candidate : \&quot;xác nhận\&quot;\napp_user ||--o{ customer_merge : \&quot;thực hiện\&quot;\n\ncustomer ||--o{ duplicate_candidate : \&quot;hồ sơ 1\&quot;\ncustomer ||--o{ duplicate_candidate : \&quot;hồ sơ 2\&quot;\n\ncustomer ||--o{ customer_merge : \&quot;hồ sơ chuẩn\&quot;\ncustomer ||--o{ customer_merge : \&quot;hồ sơ trùng\&quot;\n\nnote right of customer\nINDEX:\n- UNIQUE INDEX trên phone\n\nPhục vụ NFR1:\ntra cứu số điện thoại\n≤ 2 giây với 10.000 hồ sơ\nend note\n\nnote bottom of duplicate_candidate\nPhục vụ:\nUS5 - cảnh báo nghi trùng\nUS6 - xem danh sách nghi trùng\nUS7 - so sánh hồ sơ\nend note\n\nnote bottom of customer_merge\nPhục vụ:\nUS8 - gộp hồ sơ trùng\nLưu lại thông tin lần gộp\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R5dXdnXFutDEW8cApGT--55">
